<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- הרשת משמשת רק להורדת עדכוני קוד (Updater). ה-WebView עצמו חסום לכל כתובת חיצונית -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- עדכון האפליקציה מתוכה. המשתמש מאשר פעם אחת, ואת כל התקנה מאשרים בחלון של אנדרואיד -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- קישורי שיתוף נפתחים ישר באפליקציה (מאומת דרך assetlinks.json באתר) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="family-budget.naorkurtz1.workers.dev" android:pathPrefix="/join" />
            </intent-filter>
            <!-- גיבוי: כפתור "פתיחה באפליקציה" בעמוד ההזמנה -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="familybudget" android:host="join" />
            </intent-filter>
        </activity>
    </application>
</manifest>
